rules_version = '2';

// Stock Control — Firestore security rules.
//
// Deny by default. Roles come ONLY from /users/{uid} documents that an admin writes (the first admin
// is created by the owner in the Firebase console). Nothing the browser claims about itself is trusted.
//
// Stock integrity is enforced here, not just in the app:
//   * /inventory/balances can only change together with a NEW, immutable /stockMovements doc written in
//     the same transaction, and every changed balance must equal old - removed + added, and be >= 0.
//   * A ticket can only become "collected" from "ready", together with the movement
//     stockMovements/{ticketId}_collect whose `removed` map equals the ticket's items exactly. That
//     movement id is deterministic and movements can never be updated, so a ticket cannot be issued twice.
//   * Every ticket and user change must create a new /auditLogs entry in the same write.
//
// Rules cannot loop, so per-key checks are unrolled (nested, short-circuiting) for up to 20 product
// lines per ticket/movement. Adding a product means adding its id to productIds() below.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- identity & roles ----------
    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    function userDoc() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function hasRole(roles) { return signedIn() && userDoc().active == true && userDoc().role in roles; }
    function isAdmin() { return hasRole(['admin']); }
    function isStaff() { return hasRole(['admin', 'stock-controller']); }
    function isManager() { return hasRole(['site-manager']); }
    function isActiveUser() { return hasRole(['admin', 'stock-controller', 'site-manager']); }

    // ---------- generic validators ----------
    function text(v, max) { return v is string && v.size() <= max; }
    function optText(v, max) { return v == null || text(v, max); }
    function docId(v) { return v is string && v.matches('^[A-Za-z0-9_-]{6,80}$'); }
    function productKey(k) { return k is string && k.matches('^[a-z0-9][a-z0-9-]{0,39}$'); }

    // Catalogue product ids (must match domain.js PRODUCTS — a unit test checks this).
    function productIds() {
      return ['two-stroke-500ml', 'two-stroke-20l', 'nylon-line', 'pine-gel-5l', 'pine-gel-20l', 'non-selective-20l', 'non-selective-1l', 'selective-20l', 'selective-5l', 'bleach-5l', 'toilet-paper', 'black-bags', 'rake', 'broom', 'mop', 'broom-sticks'];
    }
    function qOk(m, k, max) { return m[k] is int && m[k] >= 1 && m[k] <= max; }
    // Rules cannot loop: this nested check stops at the end of the list, so short tickets stay cheap.
    function qtyPart(m, ks, max) {
      return (ks.size() == 0 || (qOk(m, ks[0], max) && (ks.size() == 1 || (qOk(m, ks[1], max) && (ks.size() == 2 || (qOk(m, ks[2], max) && (ks.size() == 3 || (qOk(m, ks[3], max) && (ks.size() == 4 || (qOk(m, ks[4], max) && (ks.size() == 5 || (qOk(m, ks[5], max) && (ks.size() == 6 || (qOk(m, ks[6], max) && (ks.size() == 7 || (qOk(m, ks[7], max) && (ks.size() == 8 || (qOk(m, ks[8], max) && (ks.size() == 9 || (qOk(m, ks[9], max) && (ks.size() == 10 || (qOk(m, ks[10], max) && (ks.size() == 11 || (qOk(m, ks[11], max) && (ks.size() == 12 || (qOk(m, ks[12], max) && (ks.size() == 13 || (qOk(m, ks[13], max) && (ks.size() == 14 || (qOk(m, ks[14], max) && (ks.size() == 15 || (qOk(m, ks[15], max) && (ks.size() == 16 || (qOk(m, ks[16], max) && (ks.size() == 17 || (qOk(m, ks[17], max) && (ks.size() == 18 || (qOk(m, ks[18], max) && (ks.size() == 19 || qOk(m, ks[19], max))))))))))))))))))))))))))))))))))))))));
    }
    // A {productId: positive whole quantity} map of catalogue products, at most 20 entries.
    function qtyMap(m, max) { return m is map && m.size() <= 20 && m.keys().hasOnly(productIds()) && qtyPart(m, m.keys(), max); }

    function pad4(n) {
      return n < 10 ? '000' + string(n) : (n < 100 ? '00' + string(n) : (n < 1000 ? '0' + string(n) : string(n)));
    }

    // ---------- audit binding ----------
    function auditPath(id) { return /databases/$(database)/documents/auditLogs/$(id); }
    // The write must create a brand-new audit entry named by lastAuditId in the same request.
    function auditBound(d) {
      return docId(d.lastAuditId) && !exists(auditPath(d.lastAuditId)) && existsAfter(auditPath(d.lastAuditId));
    }

    // =====================================================================
    // users/{uid}: role, active flag, contact + site assignment. Admin-managed.
    // =====================================================================
    match /users/{userId} {
      function validUser(d) {
        return d.keys().hasOnly(['role', 'active', 'displayName', 'email', 'phone', 'sites', 'updatedAt', 'updatedBy', 'lastAuditId'])
          && d.role in ['admin', 'stock-controller', 'site-manager']
          && d.active is bool
          && text(d.displayName, 100) && d.displayName.size() >= 1
          && optText(d.email, 200) && optText(d.phone, 30)
          && d.sites is list && d.sites.size() <= 30
          && d.updatedAt == request.time && d.updatedBy == uid();
      }
      allow read: if signedIn() && (userId == uid() || isStaff());
      // Admins cannot demote or deactivate themselves (prevents locking every admin out).
      allow create, update: if isAdmin() && validUser(request.resource.data) && auditBound(request.resource.data)
        && (userId != uid() || (request.resource.data.role == 'admin' && request.resource.data.active == true));
      allow delete: if false;
    }

    // =====================================================================
    // products/{productId}: catalogue reference data (the app ships the approved catalogue + images).
    // =====================================================================
    match /products/{productId} {
      allow read: if isActiveUser();
      allow create, update: if isAdmin() && productKey(productId)
        && request.resource.data.keys().hasOnly(['name', 'size', 'group', 'unit', 'img', 'active', 'sortOrder', 'updatedAt'])
        && text(request.resource.data.name, 80) && text(request.resource.data.size, 80)
        && text(request.resource.data.group, 60) && text(request.resource.data.unit, 30)
        && text(request.resource.data.img, 80) && request.resource.data.active is bool
        && request.resource.data.sortOrder is int && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    // =====================================================================
    // settings/app (company name, low-stock threshold) and settings/conversions (pack ratios).
    // Non-secret configuration only.
    // =====================================================================
    match /settings/{settingId} {
      allow read: if isActiveUser();
      allow create, update: if isAdmin() && (
        (settingId == 'app'
          && request.resource.data.keys().hasOnly(['company', 'lowThreshold', 'updatedAt', 'updatedBy'])
          && text(request.resource.data.company, 90) && request.resource.data.company.size() >= 1
          && request.resource.data.lowThreshold is int && request.resource.data.lowThreshold >= 0 && request.resource.data.lowThreshold <= 99999
          && request.resource.data.updatedAt == request.time && request.resource.data.updatedBy == uid())
        || (settingId == 'conversions'
          && request.resource.data.keys().hasOnly(['pairs', 'updatedAt', 'updatedBy'])
          && request.resource.data.pairs is map && request.resource.data.pairs.size() <= 20
          && request.resource.data.updatedAt == request.time && request.resource.data.updatedBy == uid())
      );
      allow delete: if false;
    }

    // =====================================================================
    // inventory/balances: { onHand: {productId: wholePacks}, version, lastMovementId, updatedAt, updatedBy }
    // =====================================================================
    function mvPath(id) { return /databases/$(database)/documents/stockMovements/$(id); }
    function balancesPath() { return /databases/$(database)/documents/inventory/balances; }

    function balKey(o, n, mv, k) {
      return n.get(k, -1) is int && n.get(k, -1) >= 0
        && n.get(k, -1) == o.get(k, 0) - mv.removed.get(k, 0) + mv.added.get(k, 0);
    }
    function balPart(o, n, mv) {
      return (mv.productIds.size() == 0 || (balKey(o, n, mv, mv.productIds[0]) && (mv.productIds.size() == 1 || (balKey(o, n, mv, mv.productIds[1]) && (mv.productIds.size() == 2 || (balKey(o, n, mv, mv.productIds[2]) && (mv.productIds.size() == 3 || (balKey(o, n, mv, mv.productIds[3]) && (mv.productIds.size() == 4 || (balKey(o, n, mv, mv.productIds[4]) && (mv.productIds.size() == 5 || (balKey(o, n, mv, mv.productIds[5]) && (mv.productIds.size() == 6 || (balKey(o, n, mv, mv.productIds[6]) && (mv.productIds.size() == 7 || (balKey(o, n, mv, mv.productIds[7]) && (mv.productIds.size() == 8 || (balKey(o, n, mv, mv.productIds[8]) && (mv.productIds.size() == 9 || (balKey(o, n, mv, mv.productIds[9]) && (mv.productIds.size() == 10 || (balKey(o, n, mv, mv.productIds[10]) && (mv.productIds.size() == 11 || (balKey(o, n, mv, mv.productIds[11]) && (mv.productIds.size() == 12 || (balKey(o, n, mv, mv.productIds[12]) && (mv.productIds.size() == 13 || (balKey(o, n, mv, mv.productIds[13]) && (mv.productIds.size() == 14 || (balKey(o, n, mv, mv.productIds[14]) && (mv.productIds.size() == 15 || (balKey(o, n, mv, mv.productIds[15]) && (mv.productIds.size() == 16 || (balKey(o, n, mv, mv.productIds[16]) && (mv.productIds.size() == 17 || (balKey(o, n, mv, mv.productIds[17]) && (mv.productIds.size() == 18 || (balKey(o, n, mv, mv.productIds[18]) && (mv.productIds.size() == 19 || balKey(o, n, mv, mv.productIds[19]))))))))))))))))))))))))))))))))))))))));
    }
    function balanceChangeMatchesMovement() {
      let mvId = request.resource.data.lastMovementId;
      let mv = getAfter(mvPath(mvId)).data;
      let o = resource.data.onHand;
      let n = request.resource.data.onHand;
      return docId(mvId) && !exists(mvPath(mvId))
        && n is map && n.size() <= 200 && mv.productIds.size() <= 20
        && n.diff(o).affectedKeys().hasOnly(mv.productIds)
        && balPart(o, n, mv);
    }

    match /inventory/{docName} {
      allow read: if isStaff();
      allow create: if isAdmin() && docName == 'balances'
        && request.resource.data.keys().hasOnly(['onHand', 'version', 'lastMovementId', 'updatedAt', 'updatedBy'])
        && request.resource.data.onHand == {} && request.resource.data.version == 0
        && request.resource.data.lastMovementId == null
        && request.resource.data.updatedAt == request.time && request.resource.data.updatedBy == uid();
      allow update: if isStaff() && docName == 'balances'
        && request.resource.data.keys().hasOnly(['onHand', 'version', 'lastMovementId', 'updatedAt', 'updatedBy'])
        && request.resource.data.version == resource.data.version + 1
        && request.resource.data.updatedAt == request.time && request.resource.data.updatedBy == uid()
        && balanceChangeMatchesMovement();
      allow delete: if false;
    }

    // =====================================================================
    // stockMovements/{id}: immutable signed movement { kind, added, removed, productIds, reason, ticketId, actorUid, at }
    // =====================================================================
    function ticketPath(id) { return /databases/$(database)/documents/tickets/$(id); }

    function movementKindOk(mvId, d) {
      return (d.kind == 'receive' && d.removed.size() == 0 && d.added.size() == 1 && d.ticketId == null)
        || (d.kind == 'write-off' && d.added.size() == 0 && d.removed.size() == 1 && d.ticketId == null)
        || (d.kind == 'count' && d.added.size() + d.removed.size() == 1 && d.ticketId == null)
        || (d.kind == 'conversion' && d.ticketId == null && conversionOk(d))
        || (d.kind == 'collection' && collectionMovementOk(mvId, d))
        || (d.kind == 'import' && isAdmin() && mvId.matches('^import-[A-Za-z0-9_-]{6,72}$') && d.ticketId == null);
    }
    function conversionOk(d) {
      let pairs = get(/databases/$(database)/documents/settings/conversions).data.pairs;
      let src = d.removed.keys()[0];
      let tgt = d.added.keys()[0];
      return d.removed.size() == 1 && d.added.size() == 1
        && src in pairs && pairs[src].target == tgt && d.added[tgt] == d.removed[src] * pairs[src].ratio;
    }
    function collectionMovementOk(mvId, d) {
      let before = get(ticketPath(d.ticketId)).data;
      let after = getAfter(ticketPath(d.ticketId)).data;
      return d.ticketId is string && mvId == d.ticketId + '_collect' && d.added.size() == 0
        && before.status == 'ready' && after.status == 'collected' && after.collectionMovementId == mvId
        && d.removed == before.items;
    }

    match /stockMovements/{mvId} {
      allow read: if isStaff();
      allow create: if isStaff() && docId(mvId)
        && request.resource.data.keys().hasOnly(['kind', 'added', 'removed', 'productIds', 'reason', 'ticketId', 'actorUid', 'at'])
        && request.resource.data.actorUid == uid() && request.resource.data.at == request.time
        && text(request.resource.data.reason, 220)
        && qtyMap(request.resource.data.added, 1000000) && qtyMap(request.resource.data.removed, 1000000)
        && request.resource.data.added.size() + request.resource.data.removed.size() >= 1
        && !request.resource.data.added.keys().hasAny(request.resource.data.removed.keys())
        && request.resource.data.productIds is list
        && request.resource.data.productIds.size() == request.resource.data.added.size() + request.resource.data.removed.size()
        && request.resource.data.productIds.hasAll(request.resource.data.added.keys())
        && request.resource.data.productIds.hasAll(request.resource.data.removed.keys())
        && getAfter(balancesPath()).data.lastMovementId == mvId
        && movementKindOk(mvId, request.resource.data);
      allow update, delete: if false;
    }

    // =====================================================================
    // counters/tickets-YYYYMMDD: per-day ticket sequence. Every increment must create the matching ticket.
    // =====================================================================
    match /counters/{counterId} {
      function dayOf(id) { return id.split('-')[1]; }
      allow read: if isActiveUser();
      allow create: if (isStaff() || isManager()) && counterId.matches('^tickets-[0-9]{8}$')
        && request.resource.data.keys().hasOnly(['next', 'updatedAt'])
        && request.resource.data.next == 1 && request.resource.data.updatedAt == request.time
        && existsAfter(ticketPath('SC-' + dayOf(counterId) + '-0001'));
      allow update: if (isStaff() || isManager()) && counterId.matches('^tickets-[0-9]{8}$')
        && request.resource.data.keys().hasOnly(['next', 'updatedAt'])
        && request.resource.data.next == resource.data.next + 1 && request.resource.data.updatedAt == request.time
        && existsAfter(ticketPath('SC-' + dayOf(counterId) + '-' + pad4(request.resource.data.next)));
      allow delete: if false;
    }

    // =====================================================================
    // pasteLocks/{sha256}: cross-device duplicate-paste guard. Must be written with a new ticket.
    // =====================================================================
    match /pasteLocks/{key} {
      allow read: if isStaff();
      allow create, update: if isStaff() && key.matches('^[a-f0-9]{64}$')
        && request.resource.data.keys().hasOnly(['ticketId', 'at', 'by', 'requestId'])
        && request.resource.data.at == request.time && request.resource.data.by == uid()
        && docId(request.resource.data.requestId)
        && request.resource.data.ticketId is string
        && !exists(ticketPath(request.resource.data.ticketId)) && existsAfter(ticketPath(request.resource.data.ticketId));
      allow delete: if false;
    }

    // =====================================================================
    // tickets/{ticketId}
    // =====================================================================
    function ticketShape(d) {
      return d.keys().hasOnly(['ticketId', 'seq', 'day', 'status', 'source', 'manager', 'managerUid', 'phone', 'site',
          'notes', 'rawMessage', 'items', 'reviewLines', 'pasteKey', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy',
          'reviewedAt', 'reviewedBy', 'collectedAt', 'collectedBy', 'collectionMovementId', 'cancelledAt', 'cancelledBy',
          'cancelReason', 'lastAuditId', 'legacyTicketId', 'legacyCreatedAt'])
        && d.status in ['review', 'new', 'preparing', 'ready', 'collected', 'cancelled']
        && d.source in ['manual-whatsapp-paste', 'manual-entry', 'in-app-order', 'legacy-import']
        && text(d.manager, 100) && optText(d.managerUid, 128) && text(d.phone, 30) && text(d.site, 120)
        && text(d.notes, 1500) && text(d.rawMessage, 6000)
        && qtyMap(d.items, 9999)
        && d.reviewLines is list && d.reviewLines.size() <= 80;
    }
    function confirmed(d) {
      return d.manager.size() >= 1 && d.manager != 'Manager not specified' && d.items.size() >= 1;
    }
    function stamped(d) { return d.updatedAt == request.time && d.updatedBy == uid(); }
    function counterOk(id, d) {
      let c = getAfter(/databases/$(database)/documents/counters/$('tickets-' + d.day));
      return d.day is string && d.day.matches('^[0-9]{8}$') && d.seq is int && d.seq >= 1 && d.seq <= 9999
        && c.data.next == d.seq && id == 'SC-' + d.day + '-' + pad4(d.seq);
    }
    function newTicketCommon(id, d) {
      return d.ticketId == id && ticketShape(d) && stamped(d)
        && d.createdAt == request.time && d.createdBy == uid() && auditBound(d);
    }

    function ticketCreateOk(id, d) {
      return newTicketCommon(id, d) && (
        // 1. Stock controller pastes a WhatsApp order: saved instantly in review with the raw text.
        (d.source == 'manual-whatsapp-paste' && d.status == 'review' && d.rawMessage.size() >= 1 && isStaff() && counterOk(id, d))
        // 2. Stock controller enters a complete ticket manually.
        || (d.source == 'manual-entry' && d.status == 'new' && confirmed(d) && isStaff() && counterOk(id, d))
        // 3. Phase 2: signed-in site manager submits the in-app order form for themself.
        || (d.source == 'in-app-order' && d.status == 'new' && confirmed(d) && isManager()
          && d.managerUid == uid() && d.manager == userDoc().displayName
          && d.rawMessage == '' && d.reviewLines.size() == 0
          && (d.site == '' || d.site in userDoc().sites) && counterOk(id, d))
        // 4. Admin imports a ticket from a local-prototype backup (deterministic id prevents duplicates).
        || (d.source == 'legacy-import' && id.matches('^LEGACY-[A-Za-z0-9_-]{1,60}$')
          && d.status in ['review', 'collected', 'cancelled'] && isAdmin())
      );
    }
    function ticketUpdateOk(id) {
      let o = resource.data;
      let n = request.resource.data;
      let a = n.diff(o).affectedKeys();
      return o.status in ['review', 'new', 'preparing', 'ready']
        && !a.hasAny(['ticketId', 'seq', 'day', 'source', 'rawMessage', 'pasteKey', 'createdAt', 'createdBy', 'legacyTicketId', 'legacyCreatedAt'])
        && stamped(n) && ticketShape(n) && auditBound(n)
        && (
          // Review / edit: same ticket, corrected details. review -> new on confirmation.
          (a.hasOnly(['manager', 'managerUid', 'phone', 'site', 'notes', 'items', 'reviewLines', 'reviewedAt', 'reviewedBy', 'status', 'updatedAt', 'updatedBy', 'lastAuditId'])
            && n.reviewedAt == request.time && n.reviewedBy == uid()
            && n.reviewLines.size() == 0 && confirmed(n)
            && (n.status == o.status || (o.status == 'review' && n.status == 'new')))
          // Preparation progress (never from review).
          || (a.hasOnly(['status', 'updatedAt', 'updatedBy', 'lastAuditId']) && confirmed(o)
            && ((o.status == 'new' && n.status in ['preparing', 'ready'])
                || (o.status == 'preparing' && n.status == 'ready')))
          // Collection: ready -> collected, bound to the one-time stock movement.
          || (a.hasOnly(['status', 'updatedAt', 'updatedBy', 'lastAuditId', 'collectedAt', 'collectedBy', 'collectionMovementId'])
            && o.status == 'ready' && n.status == 'collected' && confirmed(o)
            && n.collectedAt == request.time && n.collectedBy == uid()
            && n.collectionMovementId == id + '_collect'
            && !exists(mvPath(id + '_collect'))
            && getAfter(mvPath(id + '_collect')).data.removed == o.items)
          // Cancellation of an active ticket: no stock change.
          || (a.hasOnly(['status', 'updatedAt', 'updatedBy', 'lastAuditId', 'cancelledAt', 'cancelledBy', 'cancelReason'])
            && n.status == 'cancelled'
            && n.cancelledAt == request.time && n.cancelledBy == uid()
            && text(n.cancelReason, 300))
        );
    }

    match /tickets/{ticketId} {
      allow get: if isStaff() || (isManager() && resource.data.managerUid == uid());
      // Managers may only list their own tickets (the query must filter on managerUid == their uid).
      allow list: if isStaff() || (isManager() && resource.data.managerUid == uid());

      allow create: if ticketCreateOk(ticketId, request.resource.data);
      allow update: if isStaff() && ticketUpdateOk(ticketId);
      allow delete: if false;
    }

    // =====================================================================
    // auditLogs/{id}: append-only event log. Each entry must belong to the ticket/user written with it.
    // =====================================================================
    match /auditLogs/{auditId} {
      allow read: if isStaff();
      allow create: if isActiveUser() && docId(auditId)
        && request.resource.data.keys().hasOnly(['type', 'targetType', 'targetId', 'actorUid', 'at', 'summary', 'details'])
        && request.resource.data.actorUid == uid() && request.resource.data.at == request.time
        && text(request.resource.data.type, 60) && text(request.resource.data.summary, 300)
        && request.resource.data.details is map && request.resource.data.details.size() <= 20
        && request.resource.data.targetType in ['ticket', 'user']
        && request.resource.data.targetId is string
        && ((request.resource.data.targetType == 'ticket'
              && getAfter(/databases/$(database)/documents/tickets/$(request.resource.data.targetId)).data.lastAuditId == auditId)
            || (request.resource.data.targetType == 'user'
              && getAfter(/databases/$(database)/documents/users/$(request.resource.data.targetId)).data.lastAuditId == auditId));
      allow update, delete: if false;
    }
  }
}
